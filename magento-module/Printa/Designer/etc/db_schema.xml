<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- Persist the customer's Printa design on the order item -->
    <table name="sales_order_item">
        <column xsi:type="mediumtext" name="printa_design" nullable="true" comment="Printa StudioDesign JSON"/>
        <column xsi:type="mediumtext" name="printa_preview" nullable="true" comment="Printa preview PNG (data URL)"/>
    </table>
</schema>
